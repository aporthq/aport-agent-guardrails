#
# APort Agent Guardrails environment variables
# Copy to .env and fill values as needed.
#

# --- Core API configuration ---
APORT_API_URL=https://api.aport.io
APORT_API_KEY=
APORT_AGENT_ID=

# --- Evaluator behavior ---
# 1 = fail open when config is missing (default is fail-closed)
APORT_FAIL_OPEN_WHEN_MISSING_CONFIG=0

# --- Logging ---
# 1 to enable local audit logging, or set an explicit file path.
APORT_AUDIT_LOG=0

# --- CLI/framework selection ---
# Optional explicit framework (openclaw|langchain|crewai|cursor|claude-code|deerflow|n8n)
APORT_FRAMEWORK=
# 1 for non-interactive CI mode
APORT_NONINTERACTIVE=0

# --- Framework config directory overrides ---
APORT_CONFIG_DIR=
APORT_OPENCLAW_CONFIG_DIR=
APORT_LANGCHAIN_CONFIG_DIR=
APORT_CREWAI_CONFIG_DIR=
APORT_N8N_CONFIG_DIR=
APORT_CURSOR_CONFIG_DIR=
APORT_CLAUDE_CODE_CONFIG_DIR=
APORT_DEERFLOW_CONFIG_DIR=

# --- OpenClaw runtime overrides ---
OPENCLAW_CONFIG_DIR=
OPENCLAW_PASSPORT_FILE=
OPENCLAW_DECISION_FILE=
OPENCLAW_AUDIT_LOG=
